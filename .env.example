# Copy this file to .env and fill in your values. .env is git-ignored: never commit it.

# Google Gemini API key for semantic embeddings (free key: https://aistudio.google.com/apikey).
# Leave empty to use the offline local embedder instead.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2

# Folders (relative paths are resolved from the project root)
SOURCES_DIR=sample_sources
DATA_DIR=data
LOG_DIR=logs

# Rate limits (calls per minute, per category)
RATE_SEARCH_PER_MIN=20
RATE_WRITE_PER_MIN=10
RATE_INGEST_PER_MIN=3
RATE_EMBED_API_PER_MIN=30
MAX_FILE_MB=25
